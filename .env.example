# Copy this file to .env.local (git-ignored) for local development.
# On Vercel, add the same keys under Project -> Settings -> Environment Variables.

# --- EmailJS (contact form) -------------------------------------------------
# Get these from https://www.emailjs.com -> Email Services (SERVICE_ID),
# Email Templates (TEMPLATE_ID) and Account -> API keys (PUBLIC_KEY).
# The form posts directly to EmailJS's REST API from the browser, so all three
# values are exposed to the client (next.config.js forwards them via `env`).
# The public key is meant to be public; to stop others using it, allowlist
# your domain under Account -> Security in the EmailJS dashboard.
# Your EmailJS template must accept these variables:
#   from_name, from_email, message, to_name, to_email
SERVICE_ID=service_xxxxxxx
TEMPLATE_ID=template_xxxxxxx
PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx

# --- Site URL -----------------------------------------------------------------
# Canonical URL of the deployed site, no trailing slash. Used for metadataBase,
# Open Graph URLs, sitemap.xml, robots.txt and JSON-LD.
# Defaults to https://zaid-ansari-xi.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=https://zaid-ansari-xi.vercel.app

# --- Analytics (optional) -----------------------------------------------------
# Google Analytics 4 measurement ID. The gtag scripts are only rendered when
# this is set, so leave it unset to ship no analytics at all.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Vercel Web Analytics needs no key: enable it in the Vercel dashboard (Project → Analytics).
